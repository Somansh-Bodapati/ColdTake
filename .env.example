# Postgres connection string. Local dev: the Docker Compose Postgres
# (docker-compose.yml) at postgres://coldtake:coldtake@localhost:5432/coldtake_dev.
# Production: a Neon pooled connection string.
DATABASE_URL="postgres://coldtake:coldtake@localhost:5432/coldtake_dev"

# Selects the Drizzle driver in src/lib/db/client.ts. Unset (or anything but
# "neon") uses drizzle-orm/node-postgres against DATABASE_URL directly, which
# is what local Postgres needs. Set to "neon" in the deployed/serverless
# environment to route through @neondatabase/serverless's HTTP driver.
DB_DRIVER="node-postgres"

# Shared secret required on ingest endpoints (e.g. cron-triggered standings refresh)
# so only trusted callers can write. Generate a long random value per environment.
INGEST_SECRET="change-me"

# Public base URL of the deployed app, used for building absolute links (e.g. share cards).
APP_URL="http://localhost:5173"
